# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# INSTAGRAM_ACCESS_TOKEN: Optional token for Instagram Graph API to automatically fetch @caeliocoffee Reels
INSTAGRAM_ACCESS_TOKEN=

# DATABASE_URL: Optional PostgreSQL connection string (e.g. Neon, Supabase, Cloud SQL, Vercel Postgres)
# If omitted, Caelio Journal runs in resilient mode using curated articles.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Alternatively, configure individual Cloud SQL / PostgreSQL variables:
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

